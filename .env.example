# =============================================================================
#  TELEGRAM YOUTUBE GATE - CONFIGURATION
# =============================================================================
#
#  HOW TO USE THIS FILE
#  --------------------
#  1. Make a COPY of this file and name the copy   .env   (with the dot, no
#     .example on the end):
#
#         Windows :  copy .env.example .env
#         Mac/Linux: cp .env.example .env
#
#  2. Open .env in Notepad / TextEdit / VS Code and fill in the values.
#  3. NEVER share .env or upload it to GitHub. It contains your secrets.
#     (.gitignore already blocks it.)
#
#  Rules for editing:
#    * No spaces around the = sign.        GOOD: KEY=value    BAD: KEY = value
#    * No quotes needed.                   GOOD: KEY=abc123   (quotes are stripped anyway)
#    * Lines starting with # are comments and are ignored.
#
# =============================================================================


# =============================================================================
#  SECTION 1 - REQUIRED. The bot will not start without these three.
# =============================================================================

# -----------------------------------------------------------------------------
# Your Telegram bot token.
#
# HOW TO GET IT:
#   1. Open Telegram and search for:  @BotFather
#   2. Send:  /newbot
#   3. Choose a display name (e.g. "My Community Gate")
#   4. Choose a username that MUST end in "bot" (e.g. mycommunitygate_bot)
#   5. BotFather replies with a line like:
#        123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
#      Copy that whole line and paste it after the = below.
#
# KEEP THIS SECRET. Anyone with this token controls your bot.
# If it ever leaks: @BotFather > /mybots > your bot > API Token > Revoke.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# The invite link to your EXISTING Telegram group.
#
# HOW TO GET IT (on desktop or mobile):
#   1. Open your group in Telegram.
#   2. Tap the group NAME at the top.
#   3. Tap "Edit" (pencil) > "Invite Links"  -- on some clients it is
#      Manage Group > Invite Links.
#   4. Copy the primary link, or tap "Create a New Link" to make a dedicated
#      one for this bot (recommended, so you can revoke it separately later).
#
# It looks like:  https://t.me/+AbCdEfGh123456
# For a PUBLIC group it looks like: https://t.me/yourgroupname
#
# Your existing members are NOT affected by any of this.
# -----------------------------------------------------------------------------
TELEGRAM_GROUP_INVITE_LINK=

# -----------------------------------------------------------------------------
# Your YouTube channel address.
#
# HOW TO GET IT:
#   1. Open YouTube and go to your channel.
#   2. Copy the address from the browser bar.
#
# Either format works:
#   https://www.youtube.com/@yourhandle
#   https://www.youtube.com/channel/UCxxxxxxxxxxxxxxxxxxxxxx
#
# The bot automatically adds ?sub_confirmation=1 so the Subscribe pop-up
# opens straight away for the visitor.
# -----------------------------------------------------------------------------
YOUTUBE_CHANNEL_URL=


# =============================================================================
#  SECTION 2 - OPTIONAL. Everything below has a sensible default.
# =============================================================================

# -----------------------------------------------------------------------------
# The name of your community, used in the bot's messages.
# Example: COMMUNITY_NAME=the Car Enthusiasts Club
# -----------------------------------------------------------------------------
COMMUNITY_NAME=our community

# -----------------------------------------------------------------------------
# HOW USERS GET INTO THE GROUP.  static | unique | request
#
#   static   (default, easiest)
#            Sends the fixed link above. The bot does NOT need to be a group
#            admin. Downside: someone can forward that link to a friend who
#            never subscribed.
#
#   unique   Bot creates a personal, single-use, 24-hour link for each user.
#            Forwarding it is useless once it has been used once.
#            REQUIRES: TELEGRAM_GROUP_ID + bot is a group admin with
#            "Invite Users via Link".
#
#   request  STRONGEST GATE. Bot creates a link that puts people in a pending
#            "join request" queue, and only approves users who passed the gate.
#            Even if the link leaks, nobody gets in without the bot's approval.
#            REQUIRES: TELEGRAM_GROUP_ID + bot is a group admin with
#            "Invite Users via Link".
#
# Start with static. Move to request once the basics work.
# -----------------------------------------------------------------------------
INVITE_MODE=static

# -----------------------------------------------------------------------------
# Your group's numeric ID. Only needed for INVITE_MODE=unique or request.
# Looks like: -1001234567890  (yes, it starts with a minus sign)
#
# HOW TO GET IT:
#   1. Add the bot to your group first.
#   2. Run:  python -m src.tools.find_group_id
#   3. Send any message in the group. The ID is printed for you.
# -----------------------------------------------------------------------------
TELEGRAM_GROUP_ID=

# -----------------------------------------------------------------------------
# Your own Telegram user ID, so you can use /stats. Comma-separate for several.
# Get yours by messaging @userinfobot on Telegram.
# Example: ADMIN_USER_IDS=123456789
# -----------------------------------------------------------------------------
ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# Make people wait this many seconds after /start before they can confirm.
# It is gentle friction so nobody instantly taps through without looking.
# 0 = off. 15 is a reasonable value.
# -----------------------------------------------------------------------------
MIN_SECONDS_BEFORE_CONFIRM=0

# -----------------------------------------------------------------------------
# Where the SQLite database file lives. Relative paths are inside the project.
# -----------------------------------------------------------------------------
DATABASE_PATH=data/gate.sqlite3

# -----------------------------------------------------------------------------
# Logging detail: DEBUG, INFO, WARNING, ERROR, CRITICAL
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Some free hosts (Render, Koyeb) kill anything that does not answer on an
# HTTP port. Set this to the port they give you (usually via a $PORT variable)
# and the bot will serve a tiny /health endpoint. Leave blank when running on
# your own computer.
# -----------------------------------------------------------------------------
HEALTH_CHECK_PORT=


# =============================================================================
#  SECTION 3 - PHASE 2: REAL YOUTUBE VERIFICATION (optional, advanced)
# =============================================================================
#
#  READ THIS FIRST
#  ---------------
#  With VERIFICATION_MODE=honor (the default) the bot does NOT check anything
#  on YouTube. It asks the user, believes them, and TELLS THEM SO honestly.
#
#  With VERIFICATION_MODE=youtube_oauth the bot really does check: the user
#  signs in with Google, and the bot asks the official YouTube Data API
#  "is this account subscribed to my channel?".
#
#  What Phase 2 costs you:
#    * Free in money. Needs a free Google Cloud project.
#    * ~30 minutes of setup (see README section "Phase 2").
#    * A public https:// address (free options listed in the README).
#    * Google treats YouTube data as a SENSITIVE scope. Until Google verifies
#      your app, only accounts you add as "Test users" (max 100) can complete
#      the flow. Everyone else sees a scary warning screen.
#    * Some users will refuse to sign in with Google at all. Expect the
#      conversion rate to drop compared with the honour system.
#
#  Leave this whole section blank unless you are doing Phase 2.
# =============================================================================

# honor  = free, nothing is checked, disclosed honestly to the user (default)
# youtube_oauth = real verification via Google OAuth + YouTube Data API v3
VERIFICATION_MODE=honor

# -----------------------------------------------------------------------------
# Your channel's UC... ID. Required for youtube_oauth.
# Find it with:  python -m src.tools.resolve_channel
# Or manually: open your channel > View Page Source > search for "externalId".
# Looks like: UC_x5XG1OV2P6uZZ5FSM9Ttw
# -----------------------------------------------------------------------------
YOUTUBE_CHANNEL_ID=

# -----------------------------------------------------------------------------
# A free YouTube Data API key. ONLY used by the resolve_channel helper tool
# above - the bot itself does not need it. Get one at:
# https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Google OAuth client credentials (Phase 2 only).
#
# HOW TO GET THEM:
#   1. https://console.cloud.google.com/  > create a project
#   2. APIs & Services > Library > enable "YouTube Data API v3"
#   3. APIs & Services > OAuth consent screen > External > fill in the basics
#      > add the scope .../auth/youtube.readonly > add yourself as a Test user
#   4. APIs & Services > Credentials > Create Credentials
#      > OAuth client ID > Application type: "Web application"
#   5. Under "Authorised redirect URIs" add EXACTLY:
#         <OAUTH_PUBLIC_BASE_URL>/oauth/callback
#      e.g.  https://my-gate.onrender.com/oauth/callback
#   6. Copy the Client ID and Client secret here.
#
# GOOGLE_CLIENT_SECRET IS A SECRET. Never commit it, never share it.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# The public https:// address where this app can be reached from the internet.
# NO trailing slash.
#   Local testing with ngrok:  https://a1b2c3d4.ngrok-free.app
#   Render:                    https://your-service.onrender.com
# -----------------------------------------------------------------------------
OAUTH_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# A random secret used to sign the OAuth "state" value (stops tampering).
# Generate one by running:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
OAUTH_STATE_SECRET=

# -----------------------------------------------------------------------------
# Which address/port the built-in web server binds to (Phase 2).
# On a free host, set WEB_PORT to whatever port they tell you to use.
# -----------------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8080
